{
  "name": "kick-focus-userscript",
  "version": "1.40.0",
  "private": true,
  "description": "Desktop-first layout, accessibility, content filters, and ad defense for Kick.com, shipped as a userscript and an optional Manifest V3 companion extension.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && node --check dist/kick-focus.user.js && node scripts/check.mjs",
    "test": "npm run build && node --test",
    "test:unit": "node --test --experimental-test-tag-filter=unit",
    "test:artifact": "npm run build && node --test --experimental-test-tag-filter=artifact",
    "coverage": "npm run build && node --test --experimental-test-coverage",
    "coverage:floors": "npm run build && node scripts/coverage-floors.mjs",
    "verify": "npm run check && npm test",
    "verify:extension": "node scripts/verify-extension.mjs",
    "verify:firefox": "node scripts/verify-firefox.mjs",
    "release:check": "node scripts/release-checklist.mjs"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "license": "MIT"
}
